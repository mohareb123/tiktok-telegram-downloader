TELEGRAM_BOT_TOKEN=replace_with_botfather_token
MAX_FILE_SIZE_MB=49
DOWNLOAD_TIMEOUT_SECONDS=120
RATE_LIMIT_SECONDS=5
LOG_LEVEL=INFO

# Optional production hardening for TikTok requests
TIKTOK_IMPERSONATE=chrome
# Use only an authorized Netscape-format cookie file, kept outside the repository
# TIKTOK_COOKIE_FILE=/secure/path/tiktok-cookies.txt
